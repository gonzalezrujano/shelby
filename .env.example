# Imagen a usar (Docker Hub o imagen local)
SHELBY_IMAGE=tu-usuario/shelby:latest

# Puerto del daemon (shelby serve)
SHELBY_PORT=8080

# Puerto del dashboard viz (shelby viz serve)
VIZ_PORT=5000

# Nombre del dashboard a servir dentro de ./dashboards/
# Corresponde a: ./dashboards/<VIZ_DASHBOARD>/dashboard.yml
VIZ_DASHBOARD=my-dashboard

# Zona horaria
TZ=America/Mexico_City
