{#
  Custom widget: memory-donut.html.j2

  Bindings (bytes, from sys_stat memory auto-capture):
    data.used.last   → bytes in use
    data.total.last  → total bytes

  The template converts bytes → GB for display.
  No config required; total is read from the live series.
#}
{%- set used_bytes  = data.used.last  | default(0) | float -%}
{%- set total_bytes = data.total.last | default(1) | float -%}
{%- set gb          = 1073741824.0 -%}
{%- set used_gb     = (used_bytes  / gb) | round(1) -%}
{%- set total_gb    = (total_bytes / gb) | round(0) | int -%}
{%- set pct         = (used_bytes / total_bytes * 100) | round(0) | int if total_bytes > 0 else 0 -%}
{%- set pct         = [0, [pct, 100] | min] | max -%}
{%- set color       = '#4caf50' if pct < 60 else ('#ff9800' if pct < 85 else '#f44336') -%}
{%- set circ        = 188.4 -%}
{%- set dash        = (pct / 100 * circ) | round(1) -%}
{%- set trend_gb    = (data.used.trend | default(0) | float / gb) | round(2) -%}
<style>
  :host { display: flex; align-items: center; justify-content: center; height: 100%; }
  .wrap  { display: flex; align-items: center; gap: 16px; padding: 12px; }
  .info  { display: flex; flex-direction: column; gap: 4px; }
  .used  { font-size: 1.5rem; font-weight: 700; color: {{ color }}; line-height: 1; }
  .label { font-size: .72rem; color: #666; }
  .sub   { font-size: .78rem; color: #555; }
  .trend { font-size: .72rem; color: #444; margin-top: 4px; }
</style>
<div class="wrap">
  <svg width="88" height="88" viewBox="0 0 88 88">
    <circle cx="44" cy="44" r="30" fill="none" stroke="#1e1e3a" stroke-width="12"/>
    <circle cx="44" cy="44" r="30" fill="none"
            stroke="{{ color }}"
            stroke-width="12"
            stroke-dasharray="{{ dash }} {{ circ }}"
            stroke-linecap="round"
            transform="rotate(-90 44 44)"
            style="transition: stroke-dasharray .4s ease"/>
    <text x="44" y="48" text-anchor="middle"
          fill="{{ color }}" font-size="13" font-weight="700">{{ pct }}%</text>
  </svg>
  <div class="info">
    <div class="used">{{ used_gb }} GB</div>
    <div class="label">{{ meta.title }}</div>
    <div class="sub">of {{ total_gb }} GB total</div>
    <div class="trend">
      trend {% if trend_gb > 0 %}↑{% elif trend_gb < 0 %}↓{% else %}→{% endif %}
      {{ trend_gb | abs }} GB
    </div>
  </div>
</div>
